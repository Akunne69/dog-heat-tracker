{
  "name": "dog-heat-tracker",
  "version": "1.1.0",
  "private": true,
  "description": "Mobile-first dog heat-cycle tracker with scheduled Android reminders",
  "scripts": {
    "build": "npm run build:web",
    "build:web": "node scripts/build-web.js",
    "bundle:native": "esbuild native-reminders.js --bundle --format=iife --outfile=www/native-reminders.bundle.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.0"
  }
}